# Marginalia Configuration
# Copy this file to .env and fill in your values

# Browser origins and HTTP Host values (comma-separated).
# For LAN access, include this computer's LAN IP in ALLOWED_HOSTS,
# or use * only on a trusted home network.
# Production values are documented in .env.production.example.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.23

# Maximum EPUB size accepted for server storage (MB)
# MAX_EPUB_UPLOAD_MB=90

# Obsidian export vault path (optional)
# OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
